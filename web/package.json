{
  "name": "pimprobe-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "predev": "node ../dev/fetch-fonts.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node ../dev/fetch-fonts.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "npm run test:unit && playwright test",
    "test:unit": "node --test src/help/*.test.mjs src/utilities/*.test.mjs",
    "format": "prettier --write src tests *.ts *.json index.html"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "lucide-react": "^0.577.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "prettier": "^3.6.2"
  }
}
